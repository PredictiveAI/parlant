# =============================================================================
# Parlant Voice Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=parlant
POSTGRES_PASSWORD=parlant_secret_change_me
POSTGRES_DB=parlant

# =============================================================================
# Parlant API Configuration
# =============================================================================
PARLANT_HOME=/data

# LLM API Keys (at least one required)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Agent ID for voice calls (create agent first, then copy ID here)
# Use: curl http://localhost:8800/agents to list agents
PARLANT_AGENT_ID=

# Response timeout in seconds (default: 30)
PARLANT_RESPONSE_TIMEOUT=30

# =============================================================================
# Twilio Configuration
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Public URL for Twilio webhooks (use ngrok for local testing)
# Example: https://abc123.ngrok.io
PUBLIC_URL=http://localhost:8003

# =============================================================================
# GPU Configuration
# =============================================================================
# Set to the GPU device ID(s) to use
CUDA_VISIBLE_DEVICES=0

# =============================================================================
# Whisper STT Configuration
# =============================================================================
# Model options: tiny, base, small, medium, large, large-v2, large-v3
# Larger models = better accuracy but more VRAM and slower
WHISPER_MODEL=base

# =============================================================================
# Service URLs (internal Docker network - don't change unless customizing)
# =============================================================================
# These are set automatically in docker-compose.yml
# PARLANT_URL=http://parlant-api:8800
# TTS_URL=http://chattts:8001
# STT_URL=http://whisper-stt:8002
# REDIS_URL=redis://redis:6379
